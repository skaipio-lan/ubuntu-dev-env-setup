# Managed by Ansible (roles/shell/templates/zshrc.j2). Local edits are
# overwritten on the next run; the previous version is kept as a backup.
# Put machine-specific settings and secrets in ~/.zshrc.local, which is
# not tracked in Git.

export ZSH="{{ shell_ohmyzsh_dir }}"
ZSH_THEME="{{ shell_ohmyzsh_theme }}"
plugins=({{ shell_ohmyzsh_plugins | join(' ') }})

# Remind about Oh My Zsh updates instead of prompting at shell start.
zstyle ':omz:update' mode reminder

source "$ZSH/oh-my-zsh.sh"

# pyenv and nvm are installed by the development role. Each block does
# nothing when the tool is absent.
export PYENV_ROOT="$HOME/.pyenv"
if [[ -x $PYENV_ROOT/bin/pyenv ]]; then
  path=("$PYENV_ROOT/bin" $path)
  eval "$(pyenv init - zsh)"
fi

export NVM_DIR="$HOME/.nvm"
[[ -s $NVM_DIR/nvm.sh ]] && source "$NVM_DIR/nvm.sh"

[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
